{
  "name": "auth-system-backend",
  "version": "1.0.0",
  "description": "Node.js/Express authentication & authorization service (JWT + RBAC) converted from the job-easy FastAPI auth flow, per the Leads Directory Web App dev document stack.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test src/services/__tests__/*.test.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "fix:countries": "node src/db/fixCountries.js",
    "setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
