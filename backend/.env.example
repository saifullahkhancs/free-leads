# ---- App ----
NODE_ENV=development
PORT=8004
FRONTEND_BASE_URL=http://localhost:5178
BACKEND_CORS_ORIGINS=http://localhost:5178

# ---- PostgreSQL ----
# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_system

# ---- Redis ----
# Used for: rate limiting, refresh-token-reuse/revocation blacklist, caching
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# Generate strong secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Session timeout: how long a login session survives without activity. The
# refresh cookie rotates on every silent refresh, so this is a sliding window.
REFRESH_TOKEN_EXPIRE_MINUTES=60

# ---- Password reset / email verification ----
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5178/reset-password
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_ATTEMPT_LIMIT=5
VERIFICATION_ATTEMPT_WINDOW_MINUTES=15

# ---- Refresh token cookie ----
REFRESH_COOKIE_NAME=refresh_token
# true in production (requires HTTPS)
REFRESH_COOKIE_SECURE=false

# ---- SMTP / Resend (transactional email) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM_EMAIL=info@yourapp.com
SMTP_FROM_NAME=Auth System
SMTP_USE_TLS=true

# ---- Contact Us ----
# Email address that receives contact-form notifications. Falls back to
# SMTP_FROM_EMAIL when unset. Submissions are always persisted in the
# contact_messages table first, so nothing is lost if this is blank.
CONTACT_TO_EMAIL=support@yourapp.com

# ---- Migrations ----
# Run migrations automatically when the server starts (default: true)
AUTO_MIGRATE=true
MIGRATION_RETRIES=10
MIGRATION_RETRY_DELAY_MS=2000

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5

# ---- Geocoding (free map location picker on the profile page) ----
# Leave GEOAPIFY_API_KEY empty to use the public Nominatim (OpenStreetMap)
# endpoint — completely free, no key needed, ~1 request/sec (fine for
# interactive picking). For faster, more reliable lookups get a free key
# (3,000 credits/day, no credit card) at https://www.geoapify.com and set it.
GEOAPIFY_API_KEY=
# Nominatim's usage policy requires a valid User-Agent identifying the app.
NOMINATIM_USER_AGENT=freeleads-app/1.0 (contact@yourapp.com)

# ---- Quota / plans ----
# Defaults used if plans are not seeded yet (free tier).
DEFAULT_FREE_SEARCHES=10
DEFAULT_FREE_EXPORTS=1
DEFAULT_FREE_MAX_EXPORT=100

# ---- Billing / PayPal ----
# Leave PAYPAL_CLIENT_ID blank for local "mock mode" (billing simulated).
# Set creds + PAYPAL_MODE=sandbox (then live) to enable real PayPal billing.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Allow testing the webhook locally without PayPal delivering events.
PAYPAL_TEST_WEBHOOK=false

# ---- External ingest API (machine-to-machine) ----
# Leave INGEST_API_TOKEN empty to disable the ingest endpoint.
INGEST_API_TOKEN=
INGEST_HMAC_SECRET=
INGEST_TIMESTAMP_WINDOW_SECONDS=300

# ---- Google OAuth ----
# Leave GOOGLE_CLIENT_ID empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ---- Dedup ----
DEDUP_ALGORITHM=sha1

# ---- Per-user lockout / throttle ----
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=900
SEARCH_THROTTLE_PER_MINUTE=30
EXPORT_THROTTLE_PER_MINUTE=10

# ---- CSV import jobs (Redis / BullMQ background queue) ----
# Imports bigger than this many rows run as a background job instead of
# inside the HTTP request (prevents 503 gateway timeouts on large files).
IMPORT_SYNC_MAX_ROWS=2000
# Where uploaded CSVs are staged while queued/processing (defaults to a
# freeleads-imports folder in the OS temp dir).
#IMPORT_UPLOAD_DIR=/var/tmp/freeleads-imports
# Run the worker inside the API process (true, default) or separately with
# `npm run worker` (set false here on the API in that case).
IMPORT_WORKER_ENABLED=true
IMPORT_JOB_CONCURRENCY=1
IMPORT_JOB_MAX_ERRORS=200
